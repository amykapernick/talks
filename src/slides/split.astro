---
export interface Props {
	dir?: 'horizontal' | 'vertical'
	split?: ('dark' | 'light')[]
}

const { dir = 'horizontal', split = ['dark', 'light'], ...args } = Astro.props

---

<style>
	@import '@mixins';

	section {
		--split_background: transparent;

		@include code;
		

		&::before {
			background: var(--split_background);
			@include full_background;
			content: '';
		}

		&[data-direction="horizontal"] {
			&[data-split="dark,light"] {
				--split_background: linear-gradient(
						to bottom,
						$neutral 50%,
						transparent 50%
					);
			}

			&[data-split="light,dark"] {
				--split_background: linear-gradient(
						to top,
						$neutral 50%,
						transparent 50%
					);
			}
		}

		&[data-direction="vertical"] {
			grid-template-columns: repeat(2, 1fr);
			grid-column-gap: 10vw;

			& :global(pre),
			& :global(code) {
				white-space: break-spaces;
				word-wrap: break-word;
			}

			&[data-split="dark,light"] {
				--split_background: linear-gradient(
						to right,
						$neutral 50%,
						transparent 50%
					);
			}

			&[data-split="light,dark"] {
				--split_background: linear-gradient(
						to left,
						$neutral 50%,
						transparent 50%
					);
			}

			&[data-split="dark"] {
				--split_background: $neutral;
			}

			&[data-split="light"] {
				--split_background: $white;
			}
		}
	}
</style>

<section  {...args} data-direction={dir} data-split={split.join(',')}>
	<slot />
</section>